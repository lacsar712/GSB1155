.login-page {
  padding: 48rpx 32rpx 64rpx;
  background:
    radial-gradient(circle at top right, rgba(79, 70, 229, 0.2), transparent 30%),
    linear-gradient(180deg, #eff6ff 0%, #f8fafc 45%, #f3f4f6 100%);
}

.hero {
  padding: 40rpx 12rpx 32rpx;
}

.hero-badge {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.1);
  color: #2563eb;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #0f172a;
}

.hero-subtitle {
  margin-top: 16rpx;
  line-height: 1.6;
  color: #475569;
}

.form-card,
.preset-card {
  padding: 32rpx;
  margin-top: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #111827;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  margin-bottom: 12rpx;
  color: #374151;
  font-size: 26rpx;
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 2rpx solid #dbeafe;
  box-sizing: border-box;
}

.submit-button {
  margin-top: 16rpx;
  border-radius: 18rpx;
}

.hint {
  margin-top: 20rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.7;
}

.preset-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.preset-item {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #eff6ff;
  border: 2rpx solid rgba(37, 99, 235, 0.1);
}

.preset-label {
  font-size: 24rpx;
  color: #2563eb;
}

.preset-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}
